<?xml version="1.0" encoding="utf-8"?>
<UserControl
	x:Class="Mutation.Ui.Views.SettingsUi.Controls.ReasoningLevelsPicker"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d"
	TabFocusNavigation="Cycle"
	KeyDown="OnKeyDown">

	<StackPanel Spacing="10" MinWidth="240" MaxWidth="360">
		<TextBlock x:Name="HeadingText"
				   Style="{StaticResource BodyStrongTextBlockStyle}"
				   TextWrapping="Wrap"
				   AutomationProperties.HeadingLevel="Level2" />

		<TextBlock Text="Tick each level this model accepts. They are listed from lightest to heaviest."
				   Style="{StaticResource CaptionTextBlockStyle}"
				   TextWrapping="Wrap" />

		<StackPanel x:Name="LevelsPanel" Spacing="2" />

		<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
			<Button x:Name="BtnOk"
					Content="OK"
					Style="{StaticResource AccentButtonStyle}"
					MinWidth="80"
					Click="BtnOk_Click" />
			<Button x:Name="BtnCancel"
					Content="Cancel"
					MinWidth="80"
					Click="BtnCancel_Click" />
		</StackPanel>
	</StackPanel>
</UserControl>
