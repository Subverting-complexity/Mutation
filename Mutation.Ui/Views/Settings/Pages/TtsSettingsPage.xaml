<?xml version="1.0" encoding="utf-8"?>
<UserControl
	x:Class="Mutation.Ui.Views.SettingsUi.Pages.TtsSettingsPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">

	<StackPanel Spacing="14">
		<TextBlock Text="Text to Speech" Style="{StaticResource SubtitleTextBlockStyle}" />

		<TextBlock Text="Voice, rate, and volume controls live on the main window. Other narration options:"
				   TextWrapping="Wrap"
				   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

		<StackPanel Orientation="Horizontal" Spacing="8">
			<ToggleSwitch x:Name="ToggleSpeechPreprocessing"
						  Header="Enable speech preprocessing"
						  OffContent="Off"
						  OnContent="On"
						  Toggled="ToggleSpeechPreprocessing_Toggled" />
			<Button VerticalAlignment="Bottom" Click="BtnResetPreproc_Click" ToolTipService.ToolTip="Reset to default">
				<FontIcon Glyph="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="12" />
			</Button>
		</StackPanel>

		<TextBlock Text="TTS hotkeys appear in the Hotkeys tab."
				   Style="{StaticResource CaptionTextBlockStyle}"
				   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
	</StackPanel>
</UserControl>
