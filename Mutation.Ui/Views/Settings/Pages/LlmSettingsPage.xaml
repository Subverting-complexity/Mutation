<?xml version="1.0" encoding="utf-8"?>
<UserControl
	x:Class="Mutation.Ui.Views.SettingsUi.Pages.LlmSettingsPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:Mutation.Ui.Views.SettingsUi.Controls"
	xmlns:local="using:Mutation.Ui"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">

	<StackPanel Spacing="14">
		<TextBlock Text="AI assistance" Style="{StaticResource SubtitleTextBlockStyle}" />

		<controls:SecretBox x:Name="TxtOpenAiKey" Header="OpenAI API key" HelpText="{StaticResource Help.Llm.OpenAiKey}" />
		<controls:SecretBox x:Name="TxtAnthropicKey" Header="Anthropic API key" HelpText="{StaticResource Help.Llm.AnthropicKey}" />

		<StackPanel Spacing="4">
			<StackPanel Orientation="Horizontal" Spacing="6">
				<TextBlock Text="Request timeout (seconds)" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
				<controls:InfoHint Text="{StaticResource Help.Llm.RequestTimeout}" VerticalAlignment="Center" />
			</StackPanel>
			<StackPanel Orientation="Horizontal" Spacing="6">
				<NumberBox x:Name="NbTimeout"
						   AutomationProperties.Name="Request timeout (seconds)"
						   AutomationProperties.HelpText="{StaticResource Help.Llm.RequestTimeout}"
						   Minimum="5" Maximum="600"
						   SmallChange="5"
						   Width="180"
						   SpinButtonPlacementMode="Inline"
						   ValueChanged="NbTimeout_ValueChanged" />
				<Button Click="BtnResetTimeout_Click" ToolTipService.ToolTip="Reset to default"
						AutomationProperties.Name="Reset request timeout">
					<FontIcon Glyph="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="12"
							  AutomationProperties.AccessibilityView="Raw" />
				</Button>
			</StackPanel>
		</StackPanel>

		<StackPanel Spacing="8">
			<TextBlock Text="Models" Style="{StaticResource BodyStrongTextBlockStyle}" />

			<Grid ColumnSpacing="12">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="2*" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<TextBlock Grid.Column="0" Text="Name" FontWeight="SemiBold" />
				<TextBlock Grid.Column="1" Text="Provider" FontWeight="SemiBold" />
				<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
					<TextBlock Text="Temperature" VerticalAlignment="Center" FontWeight="SemiBold" />
					<controls:InfoHint Text="{StaticResource Help.Llm.Temperature}" VerticalAlignment="Center" />
				</StackPanel>
				<TextBlock Grid.Column="3" Text="Actions" FontWeight="SemiBold" />
			</Grid>

			<ListView
				x:Name="ModelsList"
				AutomationProperties.Name="Models"
				ItemsSource="{x:Bind ModelEntries, Mode=OneWay}"
				SelectionMode="None"
				IsItemClickEnabled="False"
				Background="Transparent"
				BorderThickness="0"
				IsTabStop="False">
				<ListView.ItemTemplate>
					<DataTemplate x:DataType="local:LlmModelEntry">
						<Grid ColumnSpacing="12" Padding="0,4">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="2*" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>

							<TextBox
								Grid.Column="0"
								Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
								PlaceholderText="gpt-4.1"
								HorizontalAlignment="Stretch"
								AutomationProperties.Name="Model name"
								ToolTipService.ToolTip="Model name" />

							<ComboBox
								Grid.Column="1"
								ItemsSource="{x:Bind ProviderOptions}"
								SelectedItem="{x:Bind Provider, Mode=TwoWay}"
								HorizontalAlignment="Stretch"
								AutomationProperties.Name="Provider"
								ToolTipService.ToolTip="Provider" />

							<TextBox
								Grid.Column="2"
								Text="{x:Bind TemperatureText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
								PlaceholderText="(default)"
								HorizontalAlignment="Stretch"
								AutomationProperties.Name="Temperature"
								AutomationProperties.HelpText="{StaticResource Help.Llm.Temperature}"
								ToolTipService.ToolTip="Optional temperature; leave empty to use the provider default" />

							<Button
								Grid.Column="3"
								Style="{StaticResource SubtleButtonStyle}"
								Content="Delete"
								AutomationProperties.Name="Delete model"
								Click="ModelDelete_Click"
								Tag="{x:Bind}" />
						</Grid>
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>

			<Button
				x:Name="BtnAddModel"
				Style="{StaticResource AccentButtonStyle}"
				HorizontalAlignment="Left"
				Click="BtnAddModel_Click"
				Content="Add model" />
		</StackPanel>
	</StackPanel>
</UserControl>
