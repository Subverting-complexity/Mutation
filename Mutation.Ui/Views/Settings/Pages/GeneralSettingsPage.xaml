<?xml version="1.0" encoding="utf-8"?>
<UserControl
	x:Class="Mutation.Ui.Views.SettingsUi.Pages.GeneralSettingsPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">

	<StackPanel Spacing="16">
		<TextBlock Text="General" Style="{StaticResource SubtitleTextBlockStyle}" />
		<TextBlock Text="Workspace preferences and high-level instructions to the assistant."
				   TextWrapping="Wrap"
				   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

		<StackPanel Spacing="4">
			<StackPanel Orientation="Horizontal" Spacing="8">
				<TextBlock Text="User instructions" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
				<Button Click="BtnResetUserInstructions_Click" ToolTipService.ToolTip="Reset to default">
					<FontIcon Glyph="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="12" />
				</Button>
			</StackPanel>
			<TextBox x:Name="TxtUserInstructions"
					 AcceptsReturn="True"
					 TextWrapping="Wrap"
					 MinHeight="160"
					 PlaceholderText="System-level guidance for the assistant..."
					 ScrollViewer.VerticalScrollBarVisibility="Auto"
					 TextChanged="TxtUserInstructions_TextChanged" />
		</StackPanel>
	</StackPanel>
</UserControl>
