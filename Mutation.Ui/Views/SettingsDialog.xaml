<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
	x:Class="Mutation.Ui.Views.SettingsDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Mutation.Ui.Views"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d"
	Title="Settings"
	PrimaryButtonText="Save"
	SecondaryButtonText="Cancel"
	DefaultButton="Primary"
	FullSizeDesired="True"
	HorizontalAlignment="Stretch"
	VerticalAlignment="Stretch">

	<ContentDialog.Resources>
		<x:Double x:Key="ContentDialogMaxWidth">10000</x:Double>
		<x:Double x:Key="ContentDialogMaxHeight">10000</x:Double>
		<x:Double x:Key="ContentDialogMinWidth">0</x:Double>
		<x:Double x:Key="ContentDialogMinHeight">0</x:Double>
		<DataTemplate x:Key="SettingsCategoryTemplate" x:DataType="local:SettingsCategoryItem">
			<StackPanel Orientation="Horizontal" Spacing="12"
						AutomationProperties.Name="{x:Bind DisplayName}"
						AutomationProperties.HelpText="{x:Bind Description}">
				<FontIcon Glyph="{x:Bind IconGlyph}" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center"
						  AutomationProperties.AccessibilityView="Raw" />
				<TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
			</StackPanel>
		</DataTemplate>
	</ContentDialog.Resources>

	<Grid x:Name="RootGrid" RowSpacing="12" ColumnSpacing="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="280" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<TextBox x:Name="SearchBox"
				 Grid.Row="0" Grid.Column="0"
				 PlaceholderText="Search settings..."
				 TextChanged="SearchBox_TextChanged">
			<TextBox.Resources>
				<Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}" />
			</TextBox.Resources>
		</TextBox>

		<TextBlock x:Name="ActiveCategoryHeader"
				   Grid.Row="0" Grid.Column="1"
				   Text="Settings"
				   Style="{StaticResource SubtitleTextBlockStyle}"
				   VerticalAlignment="Center" />

		<Border
			Grid.Row="1"
			Grid.Column="0"
			Padding="8"
			Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
			BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
			BorderThickness="1"
			CornerRadius="12">
			<ListView
				x:Name="CategoryList"
				AutomationProperties.Name="Settings categories"
				ItemsSource="{x:Bind FilteredCategories}"
				ItemTemplate="{StaticResource SettingsCategoryTemplate}"
				SelectionMode="Single"
				SelectionChanged="CategoryList_SelectionChanged"
				HorizontalAlignment="Stretch"
				HorizontalContentAlignment="Stretch"
				VerticalAlignment="Stretch"
				MinWidth="220"
				TabIndex="0">
				<ListView.Resources>
					<Style TargetType="ListViewItem" BasedOn="{StaticResource ListViewItemRevealStyle}">
						<Setter Property="HorizontalContentAlignment" Value="Stretch" />
					</Style>
				</ListView.Resources>
			</ListView>
		</Border>

		<Border
			Grid.Row="1"
			Grid.Column="1"
			Padding="0"
			Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
			BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
			BorderThickness="1"
			CornerRadius="12">
			<ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
				<ContentControl x:Name="PageHost"
								HorizontalContentAlignment="Stretch"
								VerticalContentAlignment="Top" />
			</ScrollViewer>
		</Border>

		<StackPanel Grid.Row="2" Grid.ColumnSpan="2"
					Orientation="Horizontal"
					Spacing="12"
					HorizontalAlignment="Right"
					VerticalAlignment="Center">
			<ToggleSwitch x:Name="AdvancedToggle"
						  OffContent="Advanced"
						  OnContent="Advanced"
						  Toggled="AdvancedToggle_Toggled" />
			<Button x:Name="OpenJsonButton"
					Content="Open Mutation.json"
					Visibility="Collapsed"
					Click="OpenJsonButton_Click" />
		</StackPanel>
	</Grid>
</ContentDialog>
