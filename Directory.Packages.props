<Project>
	<PropertyGroup>
		<!--
			One version per package for the whole solution. Projects keep their
			<PackageReference> lines but drop the Version attribute; the versions live here.
		-->
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<!--
			Lets the versions below also settle packages we never reference directly. Without
			it, NuGet takes whichever version the deepest dependency happens to ask for, which
			is how the Microsoft.Extensions.* graph ended up mixing 8.0.x and 10.0.x on a
			.NET 10 target (issue #259).
		-->
		<CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
	</PropertyGroup>

	<!-- Packages the projects reference directly. -->
	<ItemGroup>
		<PackageVersion Include="Azure.AI.Vision.ImageAnalysis" Version="1.0.0" />
		<PackageVersion Include="Concentus" Version="2.2.2" />
		<PackageVersion Include="Concentus.Oggfile" Version="1.0.7" />
		<PackageVersion Include="CoreAudio" Version="1.40.0" />
		<PackageVersion Include="coverlet.collector" Version="10.1.0" />
		<!--
			Held on 6.9.0. Deepgram 7 builds its own HTTP client with a five-attempt retry that
			also retries HTTP 429, and offers no way to switch it off or pass a client in. Under
			our own retries a rate-limited dictation would then retry silently until each attempt's
			deadline ran out and fail as a timeout, where 6.9.0 fails at once with
			TOO_MANY_REQUESTS (measured in the review of issue #443). Moving to 7 needs the retry
			policy reworked first; issue #445 tracks that.
		-->
		<PackageVersion Include="Deepgram" Version="6.9.0" />
		<PackageVersion Include="Markdig" Version="1.4.2" />
		<PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
		<PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
		<PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
		<PackageVersion Include="NAudio" Version="3.3.0" />
		<PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageVersion Include="OpenAI" Version="2.14.0" />
		<!--
			Held on the 6.2 line. 6.2.4 is the last MIT release: from 6.5.0 PDFsharp is AGPL or
			paid, and refuses to create a document without a licence key (PdfSharpLicenseException).
			Moving past 6.2 is a licensing decision, not a version bump (issue #443).
		-->
		<PackageVersion Include="PDFsharp" Version="6.2.4" />
		<!-- Polly 7 is out of support; 8.x is the supported line. See RetryAttempts.cs. -->
		<PackageVersion Include="Polly" Version="8.8.0" />
		<PackageVersion Include="ScottPlot.WinUI" Version="5.1.59" />
		<PackageVersion Include="SoundTouch.Net" Version="2.3.2" />
		<PackageVersion Include="System.Speech" Version="10.0.13" />
		<PackageVersion Include="xunit" Version="2.9.3" />
		<PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
	</ItemGroup>

	<!--
		Also pinned transitively, and for the same reason: nothing references it directly,
		so without a version here it lands on whatever the deepest dependency asks for.
		An in-major bump of the plumbing under the OpenAI client (issue #301). OpenAI 2.14.0
		(issue #415) asks for 1.15.0; the pin is one minor ahead on 1.16.0 (issue #443). Keep
		the pin so a later OpenAI bump cannot move it silently.

		Two packages #301 also suggested looking at are deliberately absent.

		Azure.Core 1.44.1 -> 1.61.0 was tried and reverted. From 1.45 onwards its net10.0
		group depends on Microsoft.Identity.Client, so pinning it added three MSAL
		assemblies — about 1.3 MB — to everything the app ships. It authenticates to Azure
		Vision with an AzureKeyCredential and never loads any of it. That is a real cost
		for no benefit, and #301 asks for exactly this treatment: drop a bump that turns
		out to carry more than it says, rather than hold up the rest.

		Serilog stays on 3.1.1. Deepgram 6.9.0 still declares 3.1.1 and 4.x is a major
		bump; nothing in the suite exercises Deepgram's logging, so a green run would not
		be evidence that forcing it is safe. It waits until Deepgram itself moves.
	-->
	<ItemGroup>
		<PackageVersion Include="System.ClientModel" Version="1.16.0" />
	</ItemGroup>

	<!--
		Pinned transitively, not referenced directly. PDFsharp 6.2 asks for 8.0.1, which
		NuGet audit flags with two denial-of-service advisories (GHSA-846f-f764-76mx, high,
		and GHSA-2fmv-rv2c-59x7, moderate). Warnings are errors here, so restore stopped and
		no Release build could pass (issue #423). The pin first went to 8.0.2, the first
		patched release on that line; it now sits on the same 10.0.x band as the rest of the
		runtime packages below (issue #443). Drop the pin once PDFsharp itself asks for a
		patched version.
	-->
	<ItemGroup>
		<PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
	</ItemGroup>

	<!--
		Pinned transitively, not referenced directly. Deepgram pulls in the 8.0.x
		Microsoft.Extensions.Http stack, which on a net10.0 target left the solution loading
		two generations of the same libraries side by side. Holding the whole family on one
		10.0.x band keeps it to one, and that band follows the runtime the app ships (10.0.13).

		Every Microsoft.Extensions.* package the solution resolves is listed, including the
		ones only Microsoft.Extensions.Hosting drags in. Those already land on 10.0.13 by way
		of Hosting's own exact pins, so naming them changes nothing today — it means a future
		Hosting bump, or dropping the Hosting reference, cannot quietly reopen the split this
		change closed.
	-->
	<ItemGroup>
		<PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.13" />
		<PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.13" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.FileExtensions" Version="10.0.13" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.13" />
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
		<PackageVersion Include="Microsoft.Extensions.Diagnostics" Version="10.0.13" />
		<PackageVersion Include="Microsoft.Extensions.Diagnostics.Abstractions" Version="10.0.13" />
		<PackageVersion Include="Microsoft.Extensions.FileProviders.Abstractions" Version="10.0.13" />
		<PackageVersion Include="Microsoft.Extensions.FileProviders.Physical" Version="10.0.13" />
		<PackageVersion Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.13" />
		<PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
		<PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.13" />
		<PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="10.0.13" />
		<PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.13" />
		<PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
		<PackageVersion Include="Microsoft.Extensions.Logging.Configuration" Version="10.0.13" />
		<PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.13" />
		<PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.13" />
		<PackageVersion Include="Microsoft.Extensions.Logging.EventLog" Version="10.0.13" />
		<PackageVersion Include="Microsoft.Extensions.Logging.EventSource" Version="10.0.13" />
		<PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.13" />
		<PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.13" />
		<PackageVersion Include="Microsoft.Extensions.Primitives" Version="10.0.13" />
	</ItemGroup>

	<!--
		Also pinned transitively, to keep runtime libraries on the band the app ships with:
		System.Memory.Data comes in through System.ClientModel on 10.0.10, and
		System.Numerics.Tensors through NAudio 3 on 9.0.0 (issue #443).
	-->
	<ItemGroup>
		<PackageVersion Include="System.Memory.Data" Version="10.0.13" />
		<PackageVersion Include="System.Numerics.Tensors" Version="10.0.13" />
	</ItemGroup>
</Project>
