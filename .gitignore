# graphify — every artifact is generated (rebuild via `graphify update .`, ~10s,
# 0 tokens). The AST cache under cache/ast/<tool-version>/ regenerates wholesale
# and is keyed by the tool version, so tracking it buried real changes in review
# under thousands of lines of churn.
graphify-out/

# The user guide is built by Documentation/UserGuideBuilder, so pandoc is no
# longer used. Kept ignored so a stray ~220MB copy can never be committed:
# it is over GitHub's 100MB per-file limit and the push would be rejected.
Documentation/pandoc.exe
